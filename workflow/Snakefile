"""GPN-Star genome-wide score release workflow."""

from pathlib import Path
import sys


configfile: workflow.source_path("config/config.yaml")


SCRATCH_ROOT = Path(config["scratch_root"])
SCF_SMOKE_CHROMOSOMES = config["scf_smoke"]["chromosomes"]
SCF_SMOKE_REPORT = str(SCRATCH_ROOT / "scf-smoke" / "{chrom}.json")
PYTHON_EXECUTABLE = sys.executable


include: "rules/common.smk"
include: "rules/inventory.smk"
include: "rules/parquet_benchmark.smk"
include: "rules/bigwig.smk"
include: "rules/release.smk"


rule artifacts:
    """Build and validate release artifacts without publishing them."""
    input:
        inventory_targets(),
        parquet_benchmark_targets(),
        bigwig_targets(),
        release_preflight_targets(),


rule all:
    input:
        rules.artifacts.input,


rule publish:
    """Publish validated artifacts from one intentional local process."""
    input:
        rules.artifacts.input,
        release_preflight_targets(),
    output:
        release_publication_report(),
    log:
        str(RELEASE_OUTPUT_ROOT / "logs" / "publication.log"),
    threads: 1
    resources:
        mem_mb=lambda wildcards: (
            release_resource("publish", "mem_mb") if RELEASE_ENABLED else 1024
        ),
        runtime=lambda wildcards: (
            release_resource("publish", "runtime") if RELEASE_ENABLED else 30
        ),
        disk_mb=lambda wildcards: (
            release_resource("publish", "disk_mb") if RELEASE_ENABLED else 1024
        ),
    run:
        run_release_publication(output[0], log[0])


rule scf_smoke:
    """Run the two-chromosome SCF environment smoke target."""
    input:
        expand(SCF_SMOKE_REPORT, chrom=SCF_SMOKE_CHROMOSOMES),
